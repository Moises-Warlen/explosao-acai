# =========================================================================
# CONFIGURAÇÕES DO SERVIDOR — EXPLOSÃO AÇAÍ
# =========================================================================

# Porta onde o servidor Node.js irá rodar
PORT=3000

# Ambiente de execução: development ou production
NODE_ENV=development

# URL base da sua aplicação (ex: http://localhost:3000 ou https://seusite.com.br)
BASE_URL=http://localhost:3000

# =========================================================================
# BANCO DE DADOS POSTGRESQL COM PRISMA
# Altere aqui para o usuário, senha e porta do seu banco PostgreSQL instalado:
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
# Exemplo local padrão:
# =========================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/explosao_acai?schema=public"

# =========================================================================
# GATEWAY DE PAGAMENTO: MERCADO PAGO
# Obtenha suas credenciais oficiais no painel do Mercado Pago:
# https://www.mercadopago.com.br/developers/panel
# Dica: Enquanto estiver com 'TEST-...', o sistema roda em modo Sandbox Inteligente!
# =========================================================================
MERCADO_PAGO_ACCESS_TOKEN=TEST-1234567890-abcdef-0987654321
MERCADO_PAGO_PUBLIC_KEY=TEST-1234567890-abcdef-0987654321
MERCADO_PAGO_WEBHOOK_SECRET=

# =========================================================================
# SEGURANÇA DO PAINEL ADMINISTRATIVO
# Altere aqui a senha de acesso ao seu painel administrativo (/admin)
# =========================================================================
ADMIN_PASSWORD=explosao123

# =========================================================================
# INFORMAÇÕES DO ESTABELECIMENTO
# =========================================================================
STORE_NAME=Explosão Açaí
STORE_PHONE=5516991098863
STORE_ADDRESS=Rua Renato Lourenço Fernandes Rosa, 1721, Aeroporto 3, Franca, SP, Brasil
